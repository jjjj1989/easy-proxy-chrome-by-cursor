{
  "manifest_version": 3,
  "name": "代理设置扩展",
  "version": "1.0",
  "description": "自定义Chrome代理设置",
  "permissions": [
    "proxy",
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon-red.png",
      "48": "icon-red.png",
      "128": "icon-red.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icon-red.png",
    "48": "icon-red.png",
    "128": "icon-red.png"
  }
}